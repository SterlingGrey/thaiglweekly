{
  "name": "thaiglweekly",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stamp": "node scripts/stamp-generated-at.mjs",
    "test": "node --experimental-strip-types --test src/lib/schedule.test.ts premium/*.test.mjs scripts/tracker-languages.test.mjs",
    "test:premium": "node --test premium/*.test.mjs",
    "review:premium": "node premium/review-server.mjs",
    "check:premium-bundle": "wrangler deploy --dry-run --config premium/wrangler.jsonc --outdir review-output/bundle",
    "prepare:languages": "node scripts/prepare-tracker-languages.mjs"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "wrangler": "4.157.0"
  }
}
