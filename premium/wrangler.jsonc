{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thai-gl-weekly-premium",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "PREMIUM_RELEASE": "disabled",
    "PREMIUM_REVIEW": "disabled",
    "PREMIUM_REVIEW_EMAILS": "",
    "CLERK_ALLOWED_ORIGIN": "https://thaiglweekly.com"
  },
  "durable_objects": {
    "bindings": [{ "name": "MEMBERS", "class_name": "MemberState" }]
  },
  "migrations": [{ "tag": "member-state-v1", "new_sqlite_classes": ["MemberState"] }]
}
